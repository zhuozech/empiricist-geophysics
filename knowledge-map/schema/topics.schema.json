{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empiricist Geophysics knowledge map: topics",
  "type": "object",
  "required": ["version", "topicCount", "topics"],
  "properties": {
    "version": { "type": "string" },
    "topicCount": { "type": "integer", "minimum": 0 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "subject", "domain", "name", "description", "introducedIn", "evidence", "assessmentPrompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^eg_[a-z0-9_]+$" },
          "type": { "type": "string", "enum": ["CONCEPTUAL", "PROCEDURAL", "REPRESENTATIONAL", "LANGUAGE", "META"] },
          "subject": { "type": "string" },
          "domain": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "introducedIn": { "type": "string", "pattern": "^[0-9]\\.[0-9]{2}$" },
          "section": { "type": ["integer", "null"] },
          "url": { "type": ["string", "null"] },
          "usedIn": { "type": "array", "items": { "type": "string" } },
          "mentionedBefore": { "type": "array", "items": { "type": "string" } },
          "figure": { "type": ["string", "null"] },
          "centrality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "assessmentPrompt": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
